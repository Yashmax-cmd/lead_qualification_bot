# Streamlit Frontend Environment Variables

# Streamlit Server Configuration
STREAMLIT_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

# Backend API Configuration
# For local development:
# API_URL=http://127.0.0.1:8000/analyze

# For Docker Compose:
# API_URL=http://backend:8000/analyze

# For GitHub Codespaces (replace with your dynamic URL):
# API_URL=https://<your-codespace-name>-8000.preview.app.github.dev/analyze

API_URL=http://127.0.0.1:8000/analyze
